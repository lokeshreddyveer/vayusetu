	<string>VayuSetu</string>
	<key>CFBundleName</key>
	<string>VayuSetu</string>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>app.vayusetu.ios.filter-refresh</string>
	</array>
